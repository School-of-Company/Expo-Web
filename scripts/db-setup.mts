await sql`create table if not exists notices (
  id serial primary key,
  title text not null,
  content text not null,
  date date not null default current_date
)`;

const [{ count }] = await sql`select count(*)::int as count from notices`;
if (count === 0) {
  await sql`insert into notices (date, title, content)
    select * from unnest(${seed.map((r) => r[0])}::date[], ${seed.map((r) => r[1])}::text[], ${seed.map((r) => r[2])}::text[])`;
  console.log(`seeded ${seed.length} notices`);
} else {
  console.log(`notices already has ${count} rows, skipped seed`);
}
